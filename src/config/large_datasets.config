// Overrides for datasets with more than a million cells (Tabula Sapiens, the Human Retina Cell
// Atlas) and the OP3 h5ad, added by scripts/create_resources/helpers.py for datasets marked
// `large`. Workers have about 480 GB.

process {
  withLabel: 'midmem|highmem|veryhighmem' {
    memory = 450.GB
  }
  withLabel: 'lowtime|midtime|hightime|veryhightime' {
    time = 48.h
  }
}
