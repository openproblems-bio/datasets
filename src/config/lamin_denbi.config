// Publish datasets to LaminDB with nf-lamin, on top of common/nextflow_helpers/labels_denbi.config.
// scripts/create_resources/launch_denbi.sh appends `lamin.instance`; the API key is a Seqera
// workspace secret (or a local Nextflow secret).

plugins {
  id 'nf-lamin@~1.0.0'
}

lamin {
  api_key = secrets.LAMIN_BOT_API_KEY

  input_artifacts {
    rules {
      // tracking a private input would register it in the public instance
      private_inputs { type = 'exclude'; pattern = 'lamin://openproblems/private/.*'; order = 1 }
    }
  }

  output_artifacts {
    // only the zarr stores become artifacts, not the state files or the trace
    exclude_pattern = '.*'
    rules {
      raw_anndata      { type = 'include'; pattern = '.*/raw\\.anndata\\.zarr$';     kind = 'dataset'; order = 1; description = 'Raw scRNA-seq dataset' }
      dataset_anndata  { type = 'include'; pattern = '.*/dataset\\.anndata\\.zarr$'; kind = 'dataset'; order = 2; description = 'Common scRNA-seq dataset' }
      raw_mudata       { type = 'include'; pattern = '.*/raw\\.mudata\\.zarr$';      kind = 'dataset'; order = 3; description = 'Raw multimodal dataset' }
      dataset_mudata   { type = 'include'; pattern = '.*/dataset\\.mudata\\.zarr$';  kind = 'dataset'; order = 4; description = 'Common multimodal dataset' }
    }
  }
}

process {
  // a failed dataset fails the run: retry when a task ran out of memory, stop otherwise
  // (labels_denbi.config ignores a task after three attempts)
  errorStrategy = { task.exitStatus in [137, 139] && task.attempt < 3 ? 'retry' : 'terminate' }
}

// labels_denbi.config writes the trace next to the results, which can't be a lamin:// URI
trace {
  file = "/vol/scratch/results/datasets/trace_${new Date().format('yyyyMMdd_HHmmss')}.txt"
}
